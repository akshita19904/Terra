NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL + PostGIS Config
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waypoint_db
DB_USER=waypoint_user
DB_PASSWORD=waypoint_password
DB_POOL_MAX=20

# Redis Cache Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Routing Service (OSRM / Mapbox / Mock)
ROUTING_PROVIDER=mock
OSRM_BASE_URL=http://router.project-osrm.org
